{
  "name": "chilleast-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "ChillEast MCP serverless — 湖南农业大学校园服务 MCP Server (Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
